# ── Supabase (ücretsiz, Railway gerekmez) ─────────────────────────────────────
# supabase.com/dashboard → Settings → API

VITE_SUPABASE_URL=https://PROJE_ID.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...anon_key...

# Kullanıcı analitik/reklam izni verdikten sonra yüklenir.
VITE_GOOGLE_TAG_ID=G-XXXXXXXXXX
VITE_META_PIXEL_ID=000000000000000

# KVKK aydinlatma metninde gorunecek gercek veri sorumlusu bilgileri.
VITE_DATA_CONTROLLER_NAME="Sirket unvani veya gercek kisi adi"
VITE_LEGAL_CONTACT_EMAIL=kvkk@example.com

# Hata izleme (opsiyonel). Boşsa Sentry tamamen devre dışı kalır.
# sentry.io → Project Settings → Client Keys (DSN)
VITE_SENTRY_DSN=

# ⚠️  service_role key'i ASLA buraya yazma ve ASLA commit etme!
# Sadece sunucu tarafı işlemler için kullanılır.
