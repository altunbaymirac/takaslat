# Backend ortam değişkenleri — bu dosyayı .env olarak kopyalayıp değerleri doldurun

# ── Veritabanı ────────────────────────────────────────────────────────────────
# Local dev (Docker Compose):
# DATABASE_URL="postgresql://takaslat:takaslat@localhost:5432/takaslat"
#
# Production (Railway / Supabase / Neon / RDS):
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/takaslat?sslmode=require"

# ── Auth ──────────────────────────────────────────────────────────────────────
# JWT_SECRET: En az 32 karakter rastgele string — ASLA paylaşmayın!
# Üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="BURAYA_EN_AZ_32_KARAKTER_RASTGELE_STRING_GIRIN"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3002
NODE_ENV=production

# Virgülle birden fazla URL eklenebilir (Vercel preview URL'leri otomatik izinli):
CLIENT_URL="https://takaslat.vercel.app,https://www.takaslat.com"
